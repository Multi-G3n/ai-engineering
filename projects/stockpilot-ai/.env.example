# Optional: relative SQLite paths resolve from the StockPilot project directory.
DATABASE_URL=sqlite:///./stockpilot.db

# Required for web startup: replace with a private random value of at least 32 characters.
# This empty placeholder intentionally cannot start an authenticated web application.
STOCKPILOT_SECRET_KEY=

# Optional; defaults to true. Use false only for local development over plain HTTP.
STOCKPILOT_COOKIE_SECURE=true

# Required only for AI answers. Leave empty to use inventory and forecasting without Gemini.
GEMINI_API_KEY=

# Optional model override; this is the application's existing default.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional AI resilience settings, in seconds (process environment still takes precedence).
# Per-attempt timeout: finite number from 0.1 to 300; converted to SDK milliseconds.
GEMINI_REQUEST_TIMEOUT_SECONDS=30
# Total provider I/O + retry/backoff budget: finite number from 0.1 to 600.
GEMINI_TOTAL_BUDGET_SECONDS=60
# Total attempts, including the first request: 1 or 2. Retries can incur extra API usage.
GEMINI_MAX_ATTEMPTS=2
